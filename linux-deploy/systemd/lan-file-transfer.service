[Unit]
Description=LAN File Transfer Assistant (Linux)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lantransfer
Group=lantransfer
WorkingDirectory=/opt/lan-file-transfer
EnvironmentFile=/opt/lan-file-transfer/env
ExecStart=/opt/lan-file-transfer/start.sh
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
